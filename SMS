<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>CK MR · SMS Tool</title>
  <meta name="description" content="CK MR SMS security testing interface." />

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600&family=Space+Grotesk:wght@500;600;700&family=Noto+Nastaliq+Urdu:wght@400;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --bg-body: #ffffff;
      --text: #1a1a2e;
      --text-dim: #4a4a6a;
      --text-faint: #8a8aaa;
      --line: rgba(120,80,255,.15);
      --line-soft: rgba(120,80,255,.08);
      --amber: #7c5cbf;
      --amber-light: rgba(120,80,255,.08);
      --success: #22c55e;
      --danger: #ef4444;
      --warning: #f59e0b;
      --card-bg: #ffffff;
      --card-border: rgba(120,80,255,.12);
      --input-bg: #f5f3ff;
      --input-border: rgba(120,80,255,.15);
      --input-focus: #7c5cbf;

      --ckmr-grad:
        linear-gradient(
          to right,
          #6366f1 0%,
          #22c55e 25%,
          #a855f7 50%,
          #22c55e 75%,
          #6366f1 100%
        );

      --font-sans: 'Inter',system-ui,sans-serif;
      --font-display: 'Space Grotesk','Inter',sans-serif;
      --font-mono: 'JetBrains Mono',ui-monospace,monospace;
      --font-urdu: 'Noto Nastaliq Urdu','Inter',serif;
    }

    body {
      font-family: var(--font-sans);
      background: var(--bg-body);
      color: var(--text);
      min-height: 100vh;
      -webkit-font-smoothing: antialiased;
      transition: background .3s ease,color .3s ease;
    }

    /* ================= HEADER ================= */

    header {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 50;
      background: rgba(255,255,255,.85);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border-bottom: 1px solid var(--line-soft);
      transition: background .3s ease;
    }

    .header-inner {
      max-width: 1200px;
      margin: auto;
      padding: .25rem 1rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: .4rem;
      margin-top: -4px;
    }

    .brand-mark {
      width: 22px;
      height: 22px;
      border-radius: 6px;
      background: linear-gradient(135deg,#6366f1,#8b5cf6,#a855f7);
      display: grid;
      place-items: center;
      box-shadow: 0 4px 14px rgba(124,92,191,.35);
    }

    .brand-mark i {
      color: #fff;
      font-size: .6rem;
    }

    .brand-name {
      font-family: var(--font-urdu);
      font-weight: 700;
      font-size: clamp(1.4rem,3.2vw,2.2rem);
      letter-spacing: .05em;
      background: var(--ckmr-grad);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmerVerySlow 25s linear infinite;
      display: inline-block;
    }

    .sub-brand {
      display: block;
      font-family: var(--font-mono);
      font-size: .7rem;
      font-weight: 700;
      color: #f97316;
      letter-spacing: .2em;
      text-transform: uppercase;
      margin-top: -4px;
    }

    .status {
      display: inline-flex;
      align-items: center;
      gap: .3rem;
      padding: .15rem .5rem;
      border-radius: 999px;
      background: rgba(34,197,94,.1);
      border: 1px solid rgba(34,197,94,.3);
      color: var(--success);
      font-size: .5rem;
      font-weight: 600;
    }

    .dot {
      position: relative;
      width: 4px;
      height: 4px;
    }

    .dot::before,
    .dot::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: 50%;
      background: var(--success);
    }

    .dot::before {
      animation: ping 1.8s cubic-bezier(0,0,.2,1) infinite;
      opacity: .7;
    }

    @keyframes ping {
      75%,100% {
        transform: scale(2.4);
        opacity: 0;
      }
    }

    @keyframes shimmerVerySlow {
      0% { background-position: 0% 50%; }
      100% { background-position: 300% 50%; }
    }

    /* ================= MAIN ================= */

    main {
      position: relative;
      z-index: 10;
      max-width: 660px;
      margin: 0 auto;
      padding: 6.2rem 1.2rem 1.2rem;
    }

    .card {
      position: relative;
      overflow: hidden;
      border-radius: 2rem;
      background: var(--card-bg);
      border: 1px solid var(--card-border);
      padding: 2.2rem;
      box-shadow:
        0 2px 0 rgba(0,0,0,.9),
        0 8px 0 rgba(0,0,0,.06),
        0 18px 40px rgba(0,0,0,.35),
        0 4px 12px rgba(0,0,0,.2);
      animation: scaleIn .4s cubic-bezier(.16,1,.3,1) both;
      transition: background .3s ease;
    }

    @media (min-width:640px) {
      .card {
        padding: 2.5rem;
      }
    }

    /* ================= HERO ================= */

    .hero {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: .2rem;
      text-align: center;
    }

    .title-wrapper {
      position: relative;
      padding: .6rem 1.8rem;
      margin: .15rem 0;
    }

    .title-wrapper::before,
    .title-wrapper::after {
      content: '';
      position: absolute;
      left: 50%;
      transform: translateX(-50%);
      width: 60%;
      height: 2px;
      background: linear-gradient(
        90deg,
        transparent,
        #8b6bd4,
        #7c5cbf,
        #8b6bd4,
        transparent
      );
    }

    .title-wrapper::before {
      top: 0;
    }

    .title-wrapper::after {
      bottom: 0;
    }

    .title {
      font-family: var(--font-urdu);
      font-weight: 700;
      font-size: clamp(1.8rem,4vw,2.6rem);
      line-height: 1.3;
      letter-spacing: .04em;
      text-align: center;
    }

    .title-line1,
    .title-line2,
    .title-line3 {
      display: block;
    }

    .title-line1 {
      font-size: clamp(1.3rem,3.2vw,2rem);
      letter-spacing: .08em;
      color: #1e293b;
    }

    .title-line2 {
      font-size: clamp(1.4rem,3.2vw,2.2rem);
      color: #1e293b;
    }

    .title-line3 {
      font-size: clamp(1.6rem,3.6vw,2.2rem);
      letter-spacing: .12em;
      color: #f97316;
    }

    .pk-highlight {
      color: #f97316;
    }

    .title-wrapper .star-left,
    .title-wrapper .star-right {
      position: absolute;
      top: 50%;
      transform: translateY(-50%);
      color: #8b6bd4;
      font-size: .7rem;
      opacity: .5;
    }

    .title-wrapper .star-left { left: 0; }
    .title-wrapper .star-right { right: 0; }

    .subtitle {
      color: var(--text-dim);
      font-size: .85rem;
      max-width: 24rem;
      margin-top: .1rem;
    }

    /* ================= INPUTS ================= */

    .field {
      margin-top: 1.8rem;
    }

    .field-label {
      display: flex;
      align-items: center;
      gap: .4rem;
      color: var(--text-dim);
      font-size: .65rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: .14em;
      margin-bottom: .6rem;
    }

    .input-wrap {
      display: flex;
      align-items: center;
      gap: .4rem;
      padding: .35rem;
      border-radius: 1rem;
      background: var(--input-bg);
      border: 1px solid var(--input-border);
      box-shadow:
        0 2px 0 rgba(0,0,0,.9),
        0 6px 16px rgba(0,0,0,.18);
      transition: .3s;
    }

    .input-wrap:focus-within {
      border-color: var(--input-focus);
      box-shadow: 0 0 0 4px var(--amber-light);
    }

    .prefix {
      display: inline-flex;
      align-items: center;
      padding: .5rem .7rem;
      border-radius: .8rem;
      background: var(--amber-light);
      border: 1px solid var(--line);
      color: var(--amber);
      font-family: var(--font-mono);
      font-weight: 700;
      font-size: .8rem;
    }

    #phoneNumber,
    #smsCount {
      flex: 1;
      background: transparent;
      border: 0;
      outline: 0;
      padding: .45rem .7rem;
      font-family: var(--font-mono);
      font-size: .95rem;
      font-weight: 600;
      color: var(--text);
      letter-spacing: .04em;
    }

    .count-field {
      margin-top: 1rem;
    }

    .count-field .input-wrap {
      max-width: 200px;
    }

    /* ================= BUTTON ================= */

    .actions {
      display: flex;
      flex-direction: column;
      gap: .7rem;
      margin-top: 1.4rem;
    }

    .btn {
      position: relative;
      overflow: hidden;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: .5rem;
      padding: .85rem 1.1rem;
      border-radius: .9rem;
      font-family: var(--font-sans);
      font-weight: 700;
      font-size: .85rem;
      cursor: pointer;
      border: 1px solid transparent;
      transition: transform .3s,box-shadow .3s;
    }

    .btn:disabled {
      opacity: .8;
      cursor: not-allowed;
    }

    .btn-danger {
      background: linear-gradient(135deg,#ef4444,#dc2626);
      color: #fff;
      box-shadow:
        0 2px 0 rgba(0,0,0,.9),
        0 8px 0 rgba(0,0,0,.06),
        0 18px 40px rgba(0,0,0,.35);
    }

    .btn-danger:hover:not(:disabled) {
      transform: translateY(-3px);
    }

    /* ================= ERROR ================= */

    .error {
      display: none;
      align-items: center;
      gap: .6rem;
      padding: .75rem .9rem;
      margin-top: .9rem;
      border-radius: .8rem;
      border: 1px solid rgba(239,68,68,.3);
      background: rgba(239,68,68,.08);
      color: var(--danger);
      font-weight: 600;
      font-size: .8rem;
    }

    .error.show {
      display: flex;
      animation: shake .45s ease;
    }

    @keyframes shake {
      0%,100% { transform: translateX(0); }
      25% { transform: translateX(-6px); }
      75% { transform: translateX(6px); }
    }

    /* ================= BIG RESULT BOX ================= */

    .result {
      display: none;
      margin-top: 1.8rem;
    }

    .result.show {
      display: block;
      animation: rise .6s cubic-bezier(.16,1,.3,1) both;
    }

    .result-inner {
      position: relative;
      overflow: hidden;
      min-height: 270px;
      border-radius: 1.5rem;
      border: 1px solid var(--card-border);
      background: var(--input-bg);
      box-shadow:
        0 2px 0 rgba(0,0,0,.9),
        0 8px 20px rgba(0,0,0,.18);
      padding: 2rem;
      transition: background .3s ease;
    }

    .result-header {
      display: flex;
      align-items: center;
      gap: .4rem;
      color: var(--amber);
      font-size: .65rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: .18em;
      margin-bottom: 1rem;
    }

    .status-msg {
      min-height: 170px;
      display: flex;
      align-items: center;
      color: var(--text-dim);
      font-size: 1rem;
      line-height: 1.7;
    }

    .highlight {
      color: var(--warning);
      font-weight: 700;
    }

    .success-text {
      color: var(--success);
      font-weight: 700;
    }

    .fail-text {
      color: var(--danger);
      font-weight: 700;
    }

    @media (min-width:640px) {
      .result-inner {
        min-height: 300px;
        padding: 2.2rem;
      }

      .status-msg {
        min-height: 190px;
        font-size: 1.05rem;
      }
    }

    @keyframes rise {
      from {
        opacity: 0;
        transform: translateY(14px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* ================= LOADING ================= */

    .loading {
      display: none;
      position: absolute;
      inset: 0;
      z-index: 20;
      align-items: center;
      justify-content: center;
      flex-direction: column;
      gap: 1.5rem;
      border-radius: 1.5rem;
      background: rgba(255,255,255,.94);
      backdrop-filter: blur(16px);
    }

    .loading.show {
      display: flex;
    }

    .globe-wrap {
      position: relative;
      width: 8rem;
      height: 8rem;
    }

    .pulse-ring {
      position: absolute;
      top: 50%;
      left: 50%;
      width: 100%;
      height: 100%;
      transform: translate(-50%,-50%);
      border-radius: 50%;
      border: 2px solid rgba(139,107,212,.45);
      animation: pulseRing 2.2s ease-out infinite;
    }

    .pulse-ring.two {
      border-color: rgba(124,92,191,.45);
      animation-delay: .7s;
    }

    @keyframes pulseRing {
      0% {
        transform: translate(-50%,-50%) scale(.75);
        opacity: .9;
      }
      100% {
        transform: translate(-50%,-50%) scale(1.8);
        opacity: 0;
      }
    }

    .globe {
      position: relative;
      width: 100%;
      height: 100%;
      border-radius: 50%;
      overflow: hidden;
      background: radial-gradient(
        circle at 30% 25%,
        #d9c8ff 0%,
        #7c5cbf 40%,
        #2b1a66 100%
      );
      box-shadow:
        0 0 55px -6px rgba(139,107,212,.75),
        inset -10px -14px 28px rgba(0,0,0,.35);
    }

    .globe-highlight {
      position: absolute;
      top: 14%;
      left: 18%;
      width: 3rem;
      height: 2.5rem;
      background: rgba(255,255,255,.4);
      border-radius: 50%;
      filter: blur(10px);
    }

    .globe-svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      animation: orbit 6s linear infinite;
    }

    @keyframes orbit {
      from { transform: rotate(0deg); }
      to { transform: rotate(360deg); }
    }

    .satellite-orbit {
      position: absolute;
      inset: -10%;
      animation: orbit 3.5s linear infinite;
    }

    .satellite {
      position: absolute;
      top: 0;
      left: 50%;
      transform: translateX(-50%);
      width: .6rem;
      height: .6rem;
      border-radius: 50%;
      background: var(--amber);
      box-shadow: 0 0 20px 4px rgba(139,107,212,.9);
    }

    .loading-text {
      font-size: .75rem;
      font-weight: 800;
      color: var(--amber);
      text-transform: uppercase;
      letter-spacing: .32em;
      animation: blink 1.6s ease-in-out infinite;
    }

    @keyframes blink {
      0%,100% { opacity: 1; }
      50% { opacity: .55; }
    }

    /* ================= FOOTER ================= */

    footer {
      position: relative;
      z-index: 10;
      padding: 2rem 1.5rem;
      border-top: 1px solid var(--line-soft);
      margin-top: .8rem;
    }

    .footer-inner {
      max-width: 660px;
      margin: auto;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 1rem;
    }

    .footer-caption {
      color: var(--text-dim);
      font-size: .9rem;
      font-weight: 500;
    }

    .copyright {
      color: var(--text-faint);
      font-size: .65rem;
    }

    .dev-mark {
      font-weight: 800;
      background: var(--ckmr-grad);
      background-size: 300% 100%;
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
      animation: shimmerVerySlow 25s linear infinite;
    }

    /* ================= DARK MODE BUTTON ================= */

    .theme-toggle {
      position: fixed;
      right: 20px;
      bottom: 130px;
      z-index: 9998;
      width: 46px;
      height: 46px;
      border: none;
      border-radius: 50%;
      background: #1a1a2e;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      box-shadow: 0 6px 20px rgba(0,0,0,.25);
      transition: transform .2s ease,background .3s ease,color .3s ease;
    }

    .theme-toggle:hover {
      transform: scale(1.08);
    }

    .theme-toggle i {
      font-size: 18px;
    }

    /* ================= WHATSAPP ================= */

    .wa-float {
      position: fixed;
      right: 20px;
      bottom: 70px;
      z-index: 999;
      width: 46px;
      height: 46px;
      border-radius: 50%;
      background: #25D366;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 6px 20px rgba(37,211,102,.4);
      cursor: pointer;
      border: none;
      transition: transform .2s ease;
      animation: waFloat 2.5s ease-in-out infinite;
    }

    .wa-float:hover {
      transform: scale(1.06);
      animation-play-state: paused;
    }

    .wa-float svg {
      width: 24px;
      height: 24px;
    }

    @keyframes waFloat {
      0%,100% { transform: translateY(0); }
      50% { transform: translateY(-8px); }
    }

    .wa-popup {
      position: fixed;
      right: 20px;
      bottom: 130px;
      z-index: 9999;
      display: none;
      flex-direction: column;
      gap: 8px;
      background: #fff;
      border: 1px solid rgba(37,211,102,.25);
      border-radius: 14px;
      padding: 10px;
      box-shadow: 0 10px 40px rgba(0,0,0,.18);
      width: 190px;
    }

    .wa-popup.open {
      display: flex;
    }

    .wa-item {
      display: block;
      background: #25D366;
      color: #fff;
      text-decoration: none;
      padding: 9px 10px;
      border-radius: 9px;
      font-size: 11px;
      font-weight: 700;
      text-align: center;
      line-height: 1.3;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      box-shadow:
        0 2px 0 rgba(0,0,0,.9),
        0 6px 16px rgba(0,0,0,.3);
    }

    /* ================= DARK THEME ================= */

    body.dark-mode {
      --bg-body: #090910;
      --text: #f4f4f7;
      --text-dim: #b8b8ca;
      --text-faint: #77778d;
      --line: rgba(139,107,212,.22);
      --line-soft: rgba(139,107,212,.12);
      --card-bg: #11111b;
      --card-border: rgba(139,107,212,.22);
      --input-bg: #191925;
      --input-border: rgba(139,107,212,.25);
      --input-focus: #9b7bea;
    }

    body.dark-mode header {
      background: rgba(9,9,16,.88);
    }

    body.dark-mode .title-line1,
    body.dark-mode .title-line2 {
      color: #f4f4f7;
    }

    body.dark-mode .card {
      box-shadow:
        0 2px 0 rgba(0,0,0,.95),
        0 8px 0 rgba(0,0,0,.5),
        0 18px 45px rgba(0,0,0,.7);
    }

    body.dark-mode .loading {
      background: rgba(9,9,16,.95);
    }

    body.dark-mode .wa-popup {
      background: #151520;
    }

    body.dark-mode .theme-toggle {
      background: #f5f5f5;
      color: #1a1a2e;
    }

    @keyframes scaleIn {
      from {
        opacity: 0;
        transform: scale(.96);
      }
      to {
        opacity: 1;
        transform: scale(1);
      }
    }
  </style>
</head>

<body>

<header>
  <div class="header-inner">
    <div class="brand">
      <div class="brand-mark">
        <i class="fa-solid fa-satellite-dish"></i>
      </div>

      <div>
        <span class="brand-name">CK MR</span>
        <span class="sub-brand">SMS BOMBER</span>
      </div>
    </div>

    <div class="status">
      <span class="dot"></span>
      Online
    </div>
  </div>
</header>

<main>
  <section class="card">

    <div class="hero">
      <div class="title-wrapper">

        <span class="star-left">✦</span>
        <span class="star-right">✦</span>

        <h1 class="title">
          <span class="title-line1">KAMRAN</span>
          <span class="title-line2">CK MR</span>
          <span class="title-line3">
            <span class="mr-highlight">.</span>
          </span>
        </h1>
      </div>

      <p class="subtitle">
        Premium SMS security testing interface.
      </p>
    </div>

    <div class="field">
      <label class="field-label" for="phoneNumber">
        <i class="fa-solid fa-phone"></i>
        Target Phone Number
      </label>

      <div class="input-wrap">
        <div class="prefix">
          <i class="fa-solid fa-plus"></i>
        </div>

        <input
          id="phoneNumber"
          type="tel"
          inputmode="numeric"
          autocomplete="off"
          placeholder="923036992121"
        />
      </div>
    </div>

    <div class="field count-field">
      <label class="field-label" for="smsCount">
        <i class="fa-solid fa-hashtag"></i>
        Number of SMS
      </label>

      <div class="input-wrap">
        <input
          id="smsCount"
          type="number"
          inputmode="numeric"
          autocomplete="off"
          placeholder="10"
          value="10"
          min="1"
          max="500"
        />
      </div>
    </div>

    <div class="actions">
      <button class="btn btn-danger" id="bombBtn" type="button">
        <i class="fa-solid fa-bomb"></i>
        <span>Start Bombing</span>
      </button>
    </div>

    <div class="error" id="errorBox">
      <i class="fa-solid fa-triangle-exclamation"></i>
      <span id="errorText">Invalid number format</span>
    </div>

    <!-- BIG RESULT BOX -->

    <div class="result" id="resultSection">

      <div class="result-inner">

